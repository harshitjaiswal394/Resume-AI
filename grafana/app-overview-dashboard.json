{
  "uid": "resumatch-app-overview",
  "title": "Resume-AI Application Overview",
  "tags": ["resumatch", "app", "critical"],
  "timezone": "browser",
  "refresh": "30s",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "backend job",
        "type": "query",
        "query": { "query": "label_values({__name__=~\"resumatch_ai_.*\"}, job)" },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "current": { "selected": true, "text": ["backend"], "value": ["backend"] },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Service health",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "stat", "title": "Backend",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "up{job=~\"$job\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 1 }
    },
    {
      "type": "stat", "title": "Prometheus",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "up{job=\"prometheus-kube-prometheus-prometheus\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 4, "y": 1 }
    },
    {
      "type": "stat", "title": "Alertmanager",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "up{job=\"prometheus-kube-prometheus-alertmanager\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 1 }
    },
    {
      "type": "stat", "title": "Grafana",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "up{job=\"prometheus-grafana\"}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 1 }
    },
    {
      "type": "stat", "title": "Backend pods ready",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(kube_pod_status_ready{namespace=\"resumatch-ai\",pod=~\"backend-.*\",condition=\"true\"})", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 1 }
    },
    {
      "type": "stat", "title": "Frontend pods ready",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(kube_pod_status_ready{namespace=\"resumatch-ai\",pod=~\"frontend-.*\",condition=\"true\"})", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 1 }
    },
    {
      "type": "row",
      "title": "Backend traffic & performance",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 4 },
      "panels": []
    },
    {
      "type": "timeseries", "title": "Requests / second by status",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(rate(resumatch_ai_http_requests_total{job=~\"$job\"}[5m])) by (status)", "legendFormat": "{{status}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 5 }
    },
    {
      "type": "stat", "title": "Typical response time",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(rate(resumatch_ai_http_request_duration_seconds_sum{job=~\"$job\"}[5m])) / sum(rate(resumatch_ai_http_request_duration_seconds_count{job=~\"$job\"}[5m]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 8, "y": 5 }
    },
    {
      "type": "stat", "title": "Slowest 5% of requests",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "histogram_quantile(0.95, sum(rate(resumatch_ai_http_request_duration_seconds_bucket{job=~\"$job\"}[5m])) by (le))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 2 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 12, "y": 5 }
    },
    {
      "type": "stat", "title": "Failed requests / second",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(rate(resumatch_ai_http_requests_total{job=~\"$job\",status=~\"5..\"}[5m]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "reqps", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.1 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 16, "y": 5 }
    },
    {
      "type": "stat", "title": "Chats / AI tasks (last hour)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(increase(resumatch_ai_chat_latency_seconds_count{job=~\"$job\"}[1h]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 20, "y": 5 }
    },
    {
      "type": "row",
      "title": "Backend AI & security",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "type": "stat", "title": "Threats blocked (last hour)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(increase(resumatch_ai_prompt_injections_total{job=~\"$job\"}[1h])) + sum(increase(resumatch_ai_output_rejected_total{job=~\"$job\"}[1h]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 5 } ] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 10 }
    },
    {
      "type": "stat", "title": "AI tokens used (last hour)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(increase(resumatch_ai_tokens_total{job=~\"$job\"}[1h]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 10 }
    },
    {
      "type": "stat", "title": "Provider failures (last hour)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(increase(resumatch_ai_provider_failures_total{job=~\"$job\"}[1h]))", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 10 }
    },
    {
      "type": "bargauge", "title": "AI model used (tokens)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(increase(resumatch_ai_tokens_total{job=~\"$job\"}[1h])) by (provider)", "legendFormat": "{{provider}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 10 }
    },
    {
      "type": "bargauge", "title": "Tools used by AI",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(increase(resumatch_ai_tool_calls_total{job=~\"$job\"}[1h])) by (tool)", "legendFormat": "{{tool}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 10 }
    },
    {
      "type": "row",
      "title": "Kubernetes workload (resumatch-ai)",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "panels": []
    },
    {
      "type": "timeseries", "title": "Backend CPU (cores)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"resumatch-ai\",pod=~\"backend-.*\",container!=\"\"}[5m])) by (pod)", "legendFormat": "{{pod}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries", "title": "Backend memory",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(container_memory_working_set_bytes{namespace=\"resumatch-ai\",pod=~\"backend-.*\",container!=\"\"}) by (pod)", "legendFormat": "{{pod}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 15 }
    },
    {
      "type": "timeseries", "title": "Backend restarts",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "kube_pod_container_status_restarts_total{namespace=\"resumatch-ai\",pod=~\"backend-.*\"}", "legendFormat": "{{pod}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 15 }
    },
    {
      "type": "timeseries", "title": "Frontend CPU (cores)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"resumatch-ai\",pod=~\"frontend-.*\",container!=\"\"}[5m])) by (pod)", "legendFormat": "{{pod}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 22 }
    },
    {
      "type": "timeseries", "title": "Frontend memory",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(container_memory_working_set_bytes{namespace=\"resumatch-ai\",pod=~\"frontend-.*\",container!=\"\"}) by (pod)", "legendFormat": "{{pod}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 22 }
    },
    {
      "type": "row",
      "title": "Cluster & nodes",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 29 },
      "panels": []
    },
    {
      "type": "stat", "title": "Nodes ready",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "gridPos": { "h": 3, "w": 4, "x": 0, "y": 30 }
    },
    {
      "type": "timeseries", "title": "Node CPU usage (%)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 33 }
    },
    {
      "type": "timeseries", "title": "Node memory usage (%)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 33 }
    },
    {
      "type": "timeseries", "title": "Node disk usage (%)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [ { "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100", "legendFormat": "{{instance}}", "refId": "A" } ],
      "fieldConfig": { "defaults": { "unit": "percent", "max": 100 }, "overrides": [] },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 33 }
    }
  ]
}
