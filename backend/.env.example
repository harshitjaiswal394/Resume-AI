VITE_RAZORPAY_KEY_ID=

# Supabase (Required for Auth & Database)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:6543/postgres?sslmode=require

# AI primary: Vertex AI Gemini on GCP
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_PROVIDER=vertex-gemini

# Resume parsing: Vertex AI Gemini is PRIMARY (actively available).
VERTEX_PARSING_MODEL=gemini-2.5-flash

# Text generation (cover letters, summary): Vertex AI Gemini is PRIMARY.
VERTEX_GEN_MODEL=gemini-2.5-flash

# NVIDIA NIM parsing fallback chain (comma-separated, priority order).
# Reached only if Vertex fails. Models confirmed available on the NVIDIA API.
NIM_MODEL_PARSING_CHAIN=nvidia/nemotron-3-nano-30b-a3b,nvidia/nemotron-3-super-120b-a12b

# Fallback / JD-parsing NVIDIA models (confirmed available).
NIM_MODEL_FALLBACK=nvidia/nemotron-3-nano-30b-a3b
NIM_MODEL_PARSING_JD=nvidia/nemotron-3-nano-30b-a3b

# AI fallback: NVIDIA NIM (used by the provider gateway for chat/reasoning).
NVIDIA_API_KEY_REASONING=
NVIDIA_API_KEY=
NVIDIA_LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional direct providers
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=

# ── AI Security Core ─────────────────────────────────────────────────────────
# Master kill-switch for the whole security layer.
AI_SECURITY_ENABLED=true

# Prompt injection / jailbreak detection (0-1 score thresholds).
AI_INJECTION_ENABLED=true
AI_INJECTION_BLOCK_THRESHOLD=0.75
AI_INJECTION_WARN_THRESHOLD=0.40

# PII detection & masking (mask before provider by default; block mode refuses).
AI_PII_ENABLED=true
AI_PII_MASK_BEFORE_PROVIDER=true
AI_PII_BLOCK_MODE=false

# Tool authorization (permission engine for search_jobs / fetch_user_resume).
AI_TOOL_PERMISSIONS_ENABLED=true

# Rate limiting (in-memory; use Redis for multi-replica deployments).
AI_RATE_LIMIT_ENABLED=true

# Audit logging.
AI_AUDIT_ENABLED=true
# NEVER enable prompt capture in production without a data-processing review:
# it persists message content (PII) to the audit_logs table.
AI_AUDIT_PROMPT_CAPTURE=false
AI_AUDIT_DB_BACKEND=true

# Prompt versioning / model governance.
AI_PROMPT_VERSIONING_ENABLED=true

# Output validation (secret leaks, prompt echoes, max length).
AI_OUTPUT_VALIDATION_ENABLED=true
AI_OUTPUT_MAX_LENGTH=20000

# Max characters kept per message by the input sanitizer.
AI_MESSAGE_MAX_LENGTH=8000
